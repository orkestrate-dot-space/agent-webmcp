9:["$","$1","c",{"children":[[["$","h1",null,{"id":"publishing-your-site","children":"Publishing your site"}],"\n",["$","p",null,{"children":"Serve one file on your domain and agents can find, drive,\nand delegate to your site. Presence is the claim: only you\ncan serve it, so nothing stands between you and a listing\nexcept the scan."}],"\n",["$","$L10",null,{"code":"curl -sS https://yourdomain.com/.well-known/agent-webmcp.json | jq .","lang":"bash"}],"\n",["$","h2",null,{"id":"the-file","children":"The file"}],"\n",["$","p",null,{"children":["Serve ",["$","code",null,{"children":"/.well-known/agent-webmcp.json"}]," as ",["$","code",null,{"children":"application/json"}],",\npublicly cacheable. Strict JSON. Three fields:"]}],"\n",["$","$L10",null,{"code":"{\n  \"version\": 1,\n  \"domain\": \"example.com\",\n  \"description\": \"Book trains, buses and flights. Use for quotes and checkout.\"\n}","lang":"json"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","code",null,{"children":"version"}]," must be ",["$","code",null,{"children":"1"}],". Unknown versions warn; known fields\nstill serve."]}],"\n",["$","li",null,{"children":[["$","code",null,{"children":"domain"}]," must equal the serving host, or the file drops.\nThis is the whole claim — nothing else proves ownership."]}],"\n",["$","li",null,{"children":[["$","code",null,{"children":"description"}]," is trigger text (≤140 chars, plain words).\nIt tells an agent whether to open the page, and doubles as\nthe task the prover checks. Write what the site is for, not\nmarketing."]}],"\n"]}],"\n",["$","p",null,{"children":["Everything else an agent can use is probed, never declared:\npublish an agent-skills index, ",["$","code",null,{"children":"llms.txt"}],", API or MCP cards,\nand the scan finds them on its own. Never declare verbs\n(live enumeration is truth), auth mechanics, credentials,\nor endpoints — unknown fields are ignored."]}],"\n",["$","h2",null,{"id":"verify","children":"Verify"}],"\n",["$","p",null,{"children":"Check the file resolves with the right content type:"}],"\n",["$","$L10",null,{"code":"curl -sS -D- -o/dev/null https://yourdomain.com/.well-known/agent-webmcp.json\ncurl -sS https://yourdomain.com/.well-known/agent-webmcp.json | jq .","lang":"bash"}],"\n",["$","p",null,{"children":["Then open ",["$","code",null,{"children":"https://agent-webmcp.vercel.app/sites/yourdomain"}],"\n— the page scans the domain and the row appears, with\nwhatever the scan found. Re-open any time to re-scan;\n",["$","code",null,{"children":"proof.verified"}]," always shows the last scan. See\n",["$","a",null,{"href":"/docs/custom-tools","children":"custom tools"}]," for how verbs prove, and\n",["$","a",null,{"href":"/docs/security","children":"security"}]," for what never ships."]}]],null,["$","$L11",null,{"children":["$","$12",null,{"name":"Next.MetadataOutlet","children":"$@13"}]}]]}]
