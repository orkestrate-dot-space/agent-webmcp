9:["$","$1","c",{"children":[[["$","h1",null,{"id":"quick-start","children":"Quick start"}],"\n",["$","blockquote",null,{"children":["\n",["$","p",null,{"children":["Beta software (",["$","code",null,{"children":"0.1.0-beta.x"}],"): breaking changes ship\nper release and are listed in the changelog. Keep\ncurrent with ",["$","code",null,{"children":"agent-webmcp upgrade --yes"}],"."]}],"\n"]}],"\n",["$","p",null,{"children":["The golden path: ",["$","code",null,{"children":"open"}]," → ",["$","code",null,{"children":"list"}]," → ",["$","code",null,{"children":"register"}]," →\n",["$","code",null,{"children":"execute"}]," → ",["$","code",null,{"children":"close"}],". Every step prints evidence."]}],"\n",["$","$L10",null,{"code":"H=$(agent-webmcp open --json https://example.com \\\n  | python3 -c \"import json,sys; print(json.load(sys.stdin)['handle'])\")\nagent-webmcp list $H\nagent-webmcp close $H --yes","lang":"bash"}],"\n",["$","h2",null,{"id":"open-and-list","children":"Open and list"}],"\n",["$","p",null,{"children":[["$","code",null,{"children":"open"}]," attaches the page and prints a handle plus a\n",["$","code",null,{"children":"toolCount"}],". That count is point-in-time: pages expose\ntools as they load, so ",["$","code",null,{"children":"0"}]," means list again, not give up."]}],"\n",["$","$L10",null,{"code":"agent-webmcp open --json https://example.com\n# {\"handle\":\"s_…\",\"url\":\"…\",\"toolCount\":0,\n#  \"reapplied\":[],\"skipped\":[]}\nagent-webmcp list $H\n# name — description rows on a TTY, JSON when piped","lang":"bash"}],"\n",["$","p",null,{"children":[["$","strong",null,{"children":"Never call a tool you have not listed."}]," An empty ",["$","code",null,{"children":"list"}],"\nmeans the page exposes nothing — say so instead of\nguessing. Fetch one tool's full record (schema included)\nbefore calling it:"]}],"\n",["$","$L10",null,{"code":"agent-webmcp list $H <tool-name>","lang":"bash"}],"\n",["$","h2",null,{"id":"author-your-first-tool","children":"Author your first tool"}],"\n",["$","p",null,{"children":["Pages that expose nothing still take authored tools. This\none answers ",["$","code",null,{"children":"pong"}],"; the fixture proves it before\nanything persists:"]}],"\n",["$","$L10",null,{"code":"agent-webmcp register $H \\\n  '{\"name\":\"ping\",\"description\":\"Ping fixture tool\",\n    \"inputSchema\":{\"type\":\"object\",\"properties\":{}},\n    \"fixtureInput\":{}}' \\\n  '(async () => { return { content: [\n    { type: \"text\", text: \"pong\" }] }; })' \\\n  --yes\nagent-webmcp list $H   # ping reads authored:true","lang":"bash"}],"\n",["$","p",null,{"children":["Writes need ",["$","code",null,{"children":"--yes"}],". Piped output is JSON. See\n",["$","a",null,{"href":"/docs/custom-tools","children":"Custom tools"}]," before authoring\nagainst a real page — authoring blind is forbidden."]}],"\n",["$","h2",null,{"id":"compose-and-close","children":"Compose and close"}],"\n",["$","p",null,{"children":[["$","code",null,{"children":"search"}]," and ",["$","code",null,{"children":"execute"}]," live on MCP only. Over MCP the\nsame session reads:"]}],"\n",["$","$L10",null,{"code":"{ \"handle\": \"s_…\", \"code\": \"return await tools.ping();\" }","lang":"json"}],"\n",["$","p",null,{"children":[["$","code",null,{"children":"execute"}]," returns ",["$","code",null,{"children":"{value, spilled, toolCalls, perSession, origins, untrusted:true}"}]," — ",["$","code",null,{"children":"untrusted"}]," is\nalways true. Then release what you opened:"]}],"\n",["$","$L10",null,{"code":"agent-webmcp close $H --yes\nagent-webmcp open --json https://example.com\n# reapplied:[\"ping\"] — memory works","lang":"bash"}],"\n",["$","p",null,{"children":["Close what you open. ",["$","code",null,{"children":"close"}]," kills only browsers the\nengine launched, never foreign ones."]}]],null,["$","$L11",null,{"children":["$","$12",null,{"name":"Next.MetadataOutlet","children":"$@13"}]}]]}]
