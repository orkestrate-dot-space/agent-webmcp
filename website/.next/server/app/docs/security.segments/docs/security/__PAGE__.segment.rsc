0:{"buildId":"4v2ruY2ROqOfZUlvfFmsu","data":[{"rsc":["$","$1","c",{"children":[[["$","h1",null,{"id":"security","children":"Security"}],"\n",["$","p",null,{"children":["Page output is untrusted data — never instructions, never\nprompt material. Tool descriptions, schemas, and return\nvalues arrive attacker-controlled. The engine marks every\n",["$","code",null,{"children":"execute"}]," envelope ",["$","code",null,{"children":"untrusted: true"}]," so the bit travels\nwith the data, not just the docs."]}],"\n",["$","h2",null,{"id":"untrusted-page-data","children":"Untrusted page data"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"Treat tool descriptions and outputs as\nattacker-controlled. Never paste them into prompts as\ninstructions."}],"\n",["$","li",null,{"children":["Verify effects, not echoes: read back changed state\nafter a consequential call; never trust ",["$","code",null,{"children":"{saved: true}"}],"."]}],"\n",["$","li",null,{"children":"Authoring a tool for a site does not endorse the site.\nA site's reply is input, not permission."}],"\n",["$","li",null,{"children":"If the MCP tool surface ever looks thin, reconnect:\nclients snapshot the tool list at connect time."}],"\n"]}],"\n",["$","h2",null,{"id":"deliberate-writes","children":"Deliberate writes"}],"\n",["$","p",null,{"children":[["$","code",null,{"children":"register"}],", ",["$","code",null,{"children":"unregister"}],", and ",["$","code",null,{"children":"close"}]," need ",["$","code",null,{"children":"--yes"}]," on\nthe CLI. There is no silent-writes mode — the flag is\nthe confirmation. Consequential authored tools go one\nfurther: ",["$","code",null,{"children":"consequential: true"}]," in the spec needs host\nconfirmation at call time, and ",["$","code",null,{"children":"readOnlyHint"}]," never\nbypasses it. Consequential tools also skip fixture\nauto-proof: hand-prove those, never auto-run."]}],"\n",["$","h2",null,{"id":"process-and-file-guards","children":"Process and file guards"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Close kills only owned browsers."}]," The engine\nsignals a pid only after verifying its command line\ncarries the engine's profile marker; foreign pids are\nnever signaled. Shutdown is TERM, wait, then KILL,\nwith the throwaway profile removed on every path.\nBorrowed tabs get best-effort tool cleanup and keep\nliving."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Registry paths stay inside the root."}]," Reads and\nwrites normalize paths and refuse anything outside\nthe root, plus any symlinked component (leaf or\nparent). An ",["$","code",null,{"children":"origin.txt"}]," marker guards slug\ncollisions between origins."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Session records are crash-safe."}]," Only the record\npersists to disk; a dead browser surfaces as a\ntransport failure on the next verb, never as a\ncorrupt store."]}],"\n"]}]],null,["$","$L2",null,{"children":["$","$3",null,{"name":"Next.MetadataOutlet","children":"$@4"}]}]]}],"isPartial":"$@5","staleTime":"$6","varyParams":null},{"rsc":["$","$1","h",{"children":[null,["$","$L7",null,{"children":[["$","meta","0",{"charSet":"utf-8"}],["$","meta","1",{"name":"viewport","content":"width=device-width, initial-scale=1"}],["$","meta","2",{"name":"theme-color","content":"#000000"}]]}],["$","div",null,{"hidden":true,"children":["$","$L8",null,{"children":["$","$3",null,{"name":"Next.Metadata","children":[["$","title","0",{"children":"Security · agent-webmcp docs"}],["$","meta","1",{"name":"description","content":"Untrusted page data, deliberate writes, and the process and file guards behind close and the registry."}],["$","meta","2",{"property":"og:title","content":"agent-webmcp · ultra-light WebMCP browser CLI"}],["$","meta","3",{"property":"og:description","content":"A small engine that turns any web page into an agent's toolkit: page tools, authored custom tools, and codemode over CLI and MCP."}],["$","meta","4",{"property":"og:url","content":"https://agent-webmcp.vercel.app"}],["$","meta","5",{"property":"og:site_name","content":"agent-webmcp"}],"$L9","$La","$Lb","$Lc","$Ld","$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15"]}]}]}],"$L16"]}],"isPartial":"$@17","staleTime":"$6","varyParams":null},{"rsc":"$L18","isPartial":"$@19","staleTime":"$6","varyParams":null},{"rsc":"$L1a","isPartial":"$@1b","staleTime":"$6","varyParams":null},{"rsc":"$L1c","isPartial":"$@1d","staleTime":"$6","varyParams":null}],"isUpgradeableISRFallback":false,"a":"$@1e","rootVaryParams":null,"needsRuntimeRequest":"$@1f"}
