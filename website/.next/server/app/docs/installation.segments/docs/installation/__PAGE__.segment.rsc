0:{"buildId":"4v2ruY2ROqOfZUlvfFmsu","data":[{"rsc":["$","$1","c",{"children":[[["$","h1",null,{"id":"installation","children":"Installation"}],"\n",["$","p",null,{"children":"Install from source with Bun. You need Bun plus a reachable\nbrowser: an agent-browser daemon (the installer sets one\nup), any Chrome with a debug port, or a remote CDP endpoint\nyour driver skill knows."}],"\n",["$","h2",null,{"id":"prerequisites","children":"Prerequisites"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Bun"}]," — the toolchain. Get it at\n",["$","a",null,{"href":"https://bun.sh","children":"bun.sh"}],"."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"agent-browser"}]," — the browser the engine connects\nto: ",["$","code",null,{"children":"npm i -g agent-browser"}],", then ",["$","code",null,{"children":"agent-browser install"}]," (downloads Chromium). Any CDP endpoint works,\nbut this is the zero-setup path the installer uses."]}],"\n",["$","li",null,{"children":"No account, no registry service, nothing hosted."}],"\n"]}],"\n",["$","h2",null,{"id":"install-from-source","children":"Install from source"}],"\n",["$","$L2",null,{"code":"git clone <repo> agent-webmcp && cd agent-webmcp\nbun install\nbun run gate        # deterministic checks — green or stop\nbun run compile     # dist/agent-webmcp, standalone binary","lang":"bash"}],"\n",["$","p",null,{"children":["Release binaries (per-OS, no registry) attach to GitHub\nreleases from 1.0 on — beta installs are source-only\n(see Staying current above). Until then, the binary you\njust compiled ",["$","em",null,{"children":"is"}]," the install: put ",["$","code",null,{"children":"dist/agent-webmcp"}],"\non your ",["$","code",null,{"children":"PATH"}],"."]}],"\n",["$","$L2",null,{"code":"export PATH=\"$PWD/dist:$PATH\"\nagent-webmcp --version   # expect 0.1.0-beta.x","lang":"bash"}],"\n",["$","h2",null,{"id":"staying-current-beta","children":"Staying current (beta)"}],"\n",["$","p",null,{"children":["Beta means breaking changes can ship in any release —\neach one is listed at the top of its changelog entry,\nwith no migration scripts until 1.0. To update a source\ninstall in place (pull, gate, compile, reinstall, with a\n",["$","code",null,{"children":".prev"}]," backup of your old binary):"]}],"\n",["$","$L2",null,{"code":"agent-webmcp upgrade --yes                 # uses your checkout (walks up to .git)\nagent-webmcp upgrade --repo ~/agent-webmcp --yes","lang":"bash"}],"\n",["$","p",null,{"children":"No checkout on this machine (binary-only install)?\nRe-run the installer instead:"}],"\n",["$","$L2",null,{"code":"curl -fsSL https://agent-webmcp.vercel.app/install.sh | bash","lang":"bash"}],"\n",["$","p",null,{"children":["Per-release binaries attach to GitHub releases from 1.0\non; until then source builds plus ",["$","code",null,{"children":"upgrade"}]," are the\ndistribution."]}],"\n",["$","h2",null,{"id":"verify-the-install","children":"Verify the install"}],"\n",["$","$L2",null,{"code":"agent-webmcp doctor      # environment report\nagent-webmcp mcp list    # the 9 served tools","lang":"bash"}],"\n",["$","p",null,{"children":[["$","code",null,{"children":"doctor"}]," prints a JSON environment report (Bun version,\nplatform, Effect version, browser reachability, resolved\nconfig). If ",["$","code",null,{"children":"open"}]," later fails with ",["$","code",null,{"children":"no browser reachable"}],", start an agent-browser daemon or pass\n",["$","code",null,{"children":"--cdp"}]," (your driver skill knows the endpoint)."]}],"\n",["$","h2",null,{"id":"add-it-as-an-mcp-server","children":"Add it as an MCP server"}],"\n",["$","$L2",null,{"code":"{\n  \"mcp\": {\n    \"agent-webmcp\": {\n      \"command\": [\"agent-webmcp\", \"mcp\", \"serve\"]\n    }\n  }\n}","lang":"json"}],"\n",["$","p",null,{"children":"Pin the registry root in the server entry so every\nspawned server resolves identically (some harnesses spawn\nper-call servers with varying working directories):"}],"\n",["$","$L2",null,{"code":"{\n  \"mcp\": {\n    \"agent-webmcp\": {\n      \"command\": [\n        \"agent-webmcp\",\n        \"mcp\",\n        \"serve\",\n        \"--registry\",\n        \"/abs/path/.agent-webmcp/registry\"\n      ]\n    }\n  }\n}","lang":"json"}],"\n","$L3"],null,"$L4"]}],"isPartial":"$@5","staleTime":"$6","varyParams":null},{"rsc":"$L7","isPartial":"$@8","staleTime":"$6","varyParams":null},{"rsc":"$L9","isPartial":"$@a","staleTime":"$6","varyParams":null},{"rsc":"$Lb","isPartial":"$@c","staleTime":"$6","varyParams":null},{"rsc":"$Ld","isPartial":"$@e","staleTime":"$6","varyParams":null}],"isUpgradeableISRFallback":false,"a":"$@f","rootVaryParams":null,"needsRuntimeRequest":"$@10"}
