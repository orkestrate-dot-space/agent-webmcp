9:["$","$1","c",{"children":[[["$","h1",null,{"id":"commands","children":"Commands"}],"\n",["$","p",null,{"children":["Seven verbs, two doors. Lifecycle and authoring verbs\nmirror on CLI and MCP; composition is MCP-only. Piped\noutput is JSON (",["$","code",null,{"children":"--json"}]," forces it, ",["$","code",null,{"children":"--plain"}]," forces\nrows). Writes need ",["$","code",null,{"children":"--yes"}],"."]}],"\n",["$","h2",null,{"id":"lifecycle","children":"Lifecycle"}],"\n",["$","$L10",null,{"code":"agent-webmcp open <url>                  # attach, print handle\nagent-webmcp open --cdp http://127.0.0.1:9222 <url>\n# fresh tab in that browser (per-call cdp, then daemon, then 9222/9229)\nagent-webmcp list <handle>               # rows on TTY, JSON piped\nagent-webmcp list <handle> <tool>        # full record + schema\nagent-webmcp close <handle> --yes        # release one session\nagent-webmcp close --all --yes           # sweep best-effort","lang":"bash"}],"\n",["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Command"}],["$","th",null,{"children":"Output"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"open"}]}],["$","td",null,{"children":["$","code",null,{"children":"{handle, url, toolCount, reapplied,"}]}]]}],["$","tr",null,{"children":[["$","td",null,{}],["$","td",null,{"children":[["$","code",null,{"children":"skipped}"}]," — ",["$","code",null,{"children":"toolCount"}]," is point-in-time"]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"list"}]}],["$","td",null,{"children":"name/description rows, or one full record"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"close <handle>"}]}],["$","td",null,{"children":["$","code",null,{"children":"{closed:[handle]}"}]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"close --all"}]}],["$","td",null,{"children":[["$","code",null,{"children":"{closed[], failed[]}"}]," per handle"]}]]}]]}]]}],"\n",["$","p",null,{"children":[["$","code",null,{"children":"open"}]," needs an absolute http(s) URL. ",["$","code",null,{"children":"toolCount: 0"}],"\nmeans list again — pages expose tools as they load.\n",["$","code",null,{"children":"--all"}]," never aborts on one dead browser; failures land\nin ",["$","code",null,{"children":"failed[]"}]," with per-handle reasons. Close kills only\nbrowsers the engine launched, never foreign ones."]}],"\n",["$","h2",null,{"id":"authoring","children":"Authoring"}],"\n",["$","$L10",null,{"code":"agent-webmcp register <handle> '<json-tool>' '<js-body>' \\\n  --yes                          # author + fixture-prove + save\nagent-webmcp register <handle> '<json-tool>' '<js-body>' \\\n  --timeout 10000 --yes          # custom proof budget (ms)\nagent-webmcp unregister <handle> <name> --yes\n# drop one live authored tool (files stay)","lang":"bash"}],"\n",["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Result"}],["$","th",null,{"children":"Meaning"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"{registered, handle, persisted:true}"}]}],["$","td",null,{"children":"proved and saved"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"fixture failed (…) — tool rolled back,"}]}],["$","td",null,{"children":"live tool removed,"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"nothing persisted."}]}],["$","td",null,{"children":"files never written"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"{unregistered, handle}"}]}],["$","td",null,{"children":"live tool dropped, files kept"}]]}]]}]]}],"\n",["$","p",null,{"children":[["$","code",null,{"children":"register"}]," rejects pre-dial (bad names, empty\ndescriptions, non-object schemas, empty bodies) and\nfails loud on page refusals. ",["$","code",null,{"children":"unregister"}]," refuses\npage-native tools — only session-authored names qualify.\nSee ",["$","a",null,{"href":"/docs/custom-tools","children":"Custom tools"}]," for the spec\nshape and the five rules."]}],"\n",["$","h2",null,{"id":"composition-mcp-only","children":"Composition (MCP only)"}],"\n",["$","$L10",null,{"code":"agent-webmcp mcp serve               # serve the 7 tools\nagent-webmcp mcp serve --registry DIR\n# pin the tool root (stable across proxy harnesses)\nagent-webmcp mcp serve --consequential allow\n# trusted loop: mutating tools run free (default ask\n# needs confirm:true per call, deny blocks them)\nagent-webmcp mcp list                # inspect the surface","lang":"bash"}],"\n","$L11","\n","$L12","\n","$L13","\n","$L14"],null,"$L15"]}]
