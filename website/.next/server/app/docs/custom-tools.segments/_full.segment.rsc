9:["$","$1","c",{"children":[[["$","h1",null,{"id":"custom-tools","children":"Custom tools"}],"\n",["$","p",null,{"children":[["$","code",null,{"children":"register"}]," authors a spec plus a plain-JS body onto the\nsession page. The engine compiles the body debugger-side\n(CSP-exempt), proves it with a fixture, then persists it\nas files. Every later ",["$","code",null,{"children":"open"}]," on that origin re-applies\nthem."]}],"\n",["$","$L10",null,{"code":"agent-webmcp register $H '<json-tool>' '<js-body>' --yes\n# {\"registered\":\"<name>\",\"handle\":\"s_…\",\"persisted\":true}","lang":"bash"}],"\n",["$","h2",null,{"id":"discovery-first","children":"Discovery first"}],"\n",["$","p",null,{"children":["The engine cannot inspect pages. Before any ",["$","code",null,{"children":"register"}],",\nbring a discovery bundle from your driver (harness\nbrowser tools, snapshot plus eval, trace file, page\nsource). Sufficient:"]}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","code",null,{"children":"url"}],", ",["$","code",null,{"children":"title"}],", scoped snapshot, target-subtree\nexcerpts"]}],"\n",["$","li",null,{"children":[["$","code",null,{"children":"candidate_hooks"}],": window functions, forms, fetch\nendpoints, plus the full schema for the chosen tool"]}],"\n",["$","li",null,{"children":[["$","code",null,{"children":"console_errors[]"}],", ",["$","code",null,{"children":"flow_steps[]"}]]}],"\n"]}],"\n",["$","p",null,{"children":["Ranked best to worst: live snapshot plus eval plus\nnetwork, then snapshot plus markdown plus bodies, then\ntrace-derived API shapes. Snapshot or text alone is\n",["$","strong",null,{"children":"insufficient"}]," — no hooks, no schemas, do not author\nfrom it."]}],"\n",["$","p",null,{"children":"Binding order matters. Capture in order:"}],"\n",["$","ol",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Viewport width"}]," (",["$","code",null,{"children":"window.innerWidth"}],") — responsive\nlayouts hide entire UIs below breakpoints."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Responsive variants"}]," — query every candidate root;\nnote which layout is live (desktop aside vs mobile\npanel vs none)."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Visibility primitives"}]," — rect-based\n(",["$","code",null,{"children":"getBoundingClientRect"}]," plus computed style). Never\n",["$","code",null,{"children":"offsetParent"}],": fixed elements always read null."]}],"\n",["$","li",null,{"children":"Only then draft spec plus body: prefer page APIs over\nDOM, feature-detect, fail naming what moved."}],"\n"]}],"\n",["$","h2",null,{"id":"the-spec-and-the-body","children":"The spec and the body"}],"\n",["$","p",null,{"children":["The spec is the standard shape — no ",["$","code",null,{"children":"title"}]," field:"]}],"\n",["$","$L10",null,{"lang":"json","title":"spec.json","code":"{\n\"name\": \"priceOf\",\n\"description\": \"What it changes plus what it returns.\",\n\"inputSchema\": {\n  \"type\": \"object\",\n  \"properties\": { \"sku\": { \"type\": \"string\" } },\n  \"required\": [\"sku\"],\n  \"additionalProperties\": false\n},\n\"fixtureInput\": { \"sku\": \"demo-1\" }\n}"}],"\n",["$","p",null,{"children":["Optional keys: ",["$","code",null,{"children":"annotations"}],", ",["$","code",null,{"children":"fixtureInput"}],", ",["$","code",null,{"children":"strict"}],",\n",["$","code",null,{"children":"consequential"}],". Names match\n",["$","code",null,{"children":"^[A-Za-z0-9_.-]{1,128}$"}],". Duplicates, empty names,\nempty descriptions, non-object schemas, and empty\nbodies fail pre-dial."]}],"\n",["$","p",null,{"children":["The body is a plain-JS function expression. No imports,\nno Effect, no ",["$","code",null,{"children":"eval"}],", no driver idioms. Five rules for\nstrong tools:"]}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Describe effects, not hopes"}]," — what it changes\nplus what it returns."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Closed schemas"}]," — ",["$","code",null,{"children":"additionalProperties: false"}],"\nwith a real ",["$","code",null,{"children":"required[]"}],"."]}],"\n",["$","li",null,{"children":["$L11"," — a tool without\none is a rumor (consequential tools excepted:\nhand-prove those, never auto-run)."]}],"\n","$L12","\n","$L13","\n"]}],"\n","$L14","\n","$L15","\n","$L16","\n","$L17","\n","$L18","\n","$L19","\n","$L1a","\n","$L1b","\n","$L1c"],null,"$L1d"]}]
