15:["$","p",null,{"children":["Registration succeeding proves nothing — one fixture\ninvoke proves. For stateful tools, prove ",["$","strong",null,{"children":"both"}],"\ntransitions (closed→open ",["$","em",null,{"children":"and"}]," open→open): fixtures\nthat pass on one branch are luck, not coverage. For\nchat-like widgets, gate the fixture read on a settled\nsignal (the reply landed, the typing indicator\ncleared) — an early read asserts against a loading\nskeleton."]}]
16:["$","$L10",null,{"code":"# variant handling: probe every candidate root,\n# record which layout answered, fail loud otherwise\nagent-webmcp register $H \\\n  '{\"name\":\"chatSend\",\"description\":\"Send a chat message\n    and return the settled reply text.\",\n    \"inputSchema\":{\"type\":\"object\",\"properties\":\n      {\"text\":{\"type\":\"string\"}},\"required\":[\"text\"],\n      \"additionalProperties\":false},\n    \"fixtureInput\":{\"text\":\"hello\"}}' \\\n  '(async ({ text }) => { … })' --yes","lang":"bash"}]
17:["$","p",null,{"children":["A failed fixture rolls back the live tool and persists\nnothing: ",["$","code",null,{"children":"fixture failed (…) — tool rolled back, nothing persisted."}]," Consequential tools skip auto-proof\nentirely — hand-prove those."]}]
18:["$","p",null,{"children":["Every success persists to\n",["$","code",null,{"children":"<root>/<origin-slug>/<name>/{spec.json,body.js}"}],".\nNext ",["$","code",null,{"children":"open"}]," on that origin re-applies them\n(",["$","code",null,{"children":"reapplied[]"}]," in the output). Collisions lose loudly\nto page-native tools; refused tools land in ",["$","code",null,{"children":"skipped[]"}],"\nwith reasons, files kept. ",["$","code",null,{"children":"list"}]," marks live authored\ntools (",["$","code",null,{"children":"authored: true"}],", file age, ",["$","code",null,{"children":"staleSuspect"}]," when\na call rotted)."]}]
