9:["$","$1","c",{"children":[[["$","h1",null,{"id":"codemode","children":"Codemode"}],"\n",["$","p",null,{"children":["Composition lives on MCP only: ",["$","code",null,{"children":"search"}]," ranks page tools\nacross sessions, ",["$","code",null,{"children":"execute"}]," runs one JS program over them.\nThe CLI has no ",["$","code",null,{"children":"search"}]," or ",["$","code",null,{"children":"execute"}]," — wire the MCP\nserver (see ",["$","a",null,{"href":"/docs/installation","children":"Installation"}],") and call\nthem as tools."]}],"\n",["$","h2",null,{"id":"search","children":"Search"}],"\n",["$","p",null,{"children":["One query across sessions. Name handles to fail loud on\nan unknown session; omit them to sweep every session\nbest-effort, with misses recorded in ",["$","code",null,{"children":"skipped"}],"."]}],"\n",["$","$L10",null,{"code":"{ \"query\": \"price\", \"handles\": [\"s_abc123\"] }","lang":"json"}],"\n",["$","$L10",null,{"code":"{ \"query\": \"price\", \"tools\": [\n  { \"session\": \"s_abc123\", \"tool\": {}, \"score\": 12 }\n], \"skipped\": [] }","lang":"json"}],"\n",["$","p",null,{"children":["Ranking is deterministic and field-weighted: name exact\nmatch outranks a name substring, which outranks a\ndescription hit, which outranks a schema-text hit. Ties\nbreak alphabetically. A dead browser degrades the sweep\n(",["$","code",null,{"children":"browser unreachable"}]," in ",["$","code",null,{"children":"skipped"}],") — it never kills\nits siblings."]}],"\n",["$","h2",null,{"id":"execute","children":"Execute"}],"\n",["$","p",null,{"children":["Real code over session tools via a ",["$","code",null,{"children":"tools.*"}]," proxy. One\nhandle binds tools flat; ",["$","code",null,{"children":"sessions[]"}]," namespaces them\nfor cross-site joins (",["$","code",null,{"children":"tools.s1.priceOf"}],", alias with\n",["$","code",null,{"children":"as"}],", else ",["$","code",null,{"children":"s1"}],"…",["$","code",null,{"children":"sN"}],")."]}],"\n",["$","$L10",null,{"code":"{ \"handle\": \"s_abc123\",\n  \"code\": \"return await tools.priceOf({sku:'demo-1'});\" }","lang":"json"}],"\n",["$","$L10",null,{"code":"{ \"sessions\": [\n    { \"handle\": \"s_aaa\", \"as\": \"shop\" },\n    { \"handle\": \"s_bbb\", \"as\": \"docs\" } ],\n  \"code\": \"const p = await tools.shop.priceOf({sku:'x'});\nreturn { p, d: await tools.docs.lookup({ q: p }) };\" }","lang":"json"}],"\n",["$","p",null,{"children":["Unknown tool paths reach the host and reply ",["$","code",null,{"children":"unknown tool path"}]," instead of dying in-page. ",["$","code",null,{"children":"await"}]," never\ntraps on ",["$","code",null,{"children":"then"}],". Return values normalize (functions,\nbigints, and deep trees collapse to safe shapes)."]}],"\n",["$","h2",null,{"id":"budgets-and-envelopes","children":"Budgets and envelopes"}],"\n",["$","p",null,{"children":["Budgets validate pre-dial and enforce during the run.\nPast them the run fails ",["$","em",null,{"children":"as data"}]," (an error envelope),\nnever as a throw."]}],"\n",["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Budget"}],["$","th",null,{"children":"Default"}],["$","th",null,{"children":"Max"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"timeoutMs"}]}],["$","td",null,{"children":"60000"}],["$","td",null,{"children":"300000"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"maxToolCalls"}]}],["$","td",null,{"children":"25"}],["$","td",null,{"children":"—"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"maxChars"}]}],["$","td",null,{"children":"16000"}],["$","td",null,{"children":"—"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"maxResultChars"}]}],["$","td",null,{"children":"64000"}],["$","td",null,{"children":"—"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"code length"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"64000 chars"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"sessions per run"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"8"}]]}]]}]]}],"\n",["$","p",null,{"children":["Every envelope carries ",["$","code",null,{"children":"untrusted: true"}]," — page data is\nnever instructions, even when it looks like an answer:"]}],"\n",["$","$L10",null,{"code":"{ \"value\": {}, \"spilled\": false, \"toolCalls\": 2,\n  \"perSession\": { \"page\": 2 }, \"origins\": [\"s_abc123\"],\n  \"untrusted\": true }","lang":"json"}],"\n","$L11","\n","$L12","\n","$L13","\n","$L14","\n","$L15"],null,"$L16"]}]
