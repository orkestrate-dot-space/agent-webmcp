10:["$","p",null,{"children":[["$","strong",null,{"children":"Breaking:"}]," the engine no longer launches or owns a browser.\n",["$","code",null,{"children":"open"}]," needs a reachable one (flag ",["$","code",null,{"children":"--cdp"}]," → ",["$","code",null,{"children":"browser.cdp"}],"\n→ answering agent-browser daemon, else loopback 9222/9229, else fail loud naming the\nfix). ",["$","code",null,{"children":"--headed"}]," is rejected (display belongs to your browser);\n",["$","code",null,{"children":"browser.{engine,headed,idleTimeout,profile}"}]," config keys are\ngone (unknown keys ignored, old files still parse); ",["$","code",null,{"children":"open"}],"\noutput drops ",["$","code",null,{"children":"headed"}],"/",["$","code",null,{"children":"borrowed"}],"; ",["$","code",null,{"children":"close"}]," closes its tab, never\na browser. Install ",["$","code",null,{"children":"agent-browser"}]," (plus its Chrome) for the\nzero-setup path."]}]
11:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Config file"}]," (",["$","code",null,{"children":"~/.config/agent-webmcp/config.json"}],",\nproject ",["$","code",null,{"children":".agent-webmcp/config.json"}],"): ",["$","code",null,{"children":"browser.cdp"}],"\n(default endpoint; ",["$","code",null,{"children":"{env:}"}]," for tokens),\n",["$","code",null,{"children":"index.enabled"}],", ",["$","code",null,{"children":"permissions.consequential"}],"\n(",["$","code",null,{"children":"ask"}],"|",["$","code",null,{"children":"allow"}],"|",["$","code",null,{"children":"deny"}],", default ",["$","code",null,{"children":"ask"}],"; consequential\nverbs need ",["$","code",null,{"children":"execute {confirm: true}"}],")."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":[["$","code",null,{"children":"find"}]," verb"]}],": indexed-site search splits out of\n",["$","code",null,{"children":"search"}]," (live verbs only again); ",["$","code",null,{"children":"open"}]," keeps its\nadvisory ",["$","code",null,{"children":"index"}]," record; both honor ",["$","code",null,{"children":"index.enabled"}],"."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":[["$","code",null,{"children":"upgrade"}]," command"]}],": source upgrade in place\n(pull → gate → compile → reinstall with ",["$","code",null,{"children":".prev"}],"\nbackup). Refuses dirty trees and bare-",["$","code",null,{"children":"bun"}]," runs."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Beta markers"}],": version ",["$","code",null,{"children":"0.1.0-beta.x"}],", hero badge,\n",["$","code",null,{"children":"doctor"}]," reports ",["$","code",null,{"children":"release: \"beta\""}],"."]}],"\n"]}]
