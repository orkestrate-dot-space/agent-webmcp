13:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Seven verbs"}],": ",["$","code",null,{"children":"open list search register execute close unregister"}],". Composition (",["$","code",null,{"children":"search"}],", ",["$","code",null,{"children":"execute"}],")\nis MCP-only; the CLI mirrors lifecycle plus ",["$","code",null,{"children":"doctor"}],",\n",["$","code",null,{"children":"mcp list/serve"}],", ",["$","code",null,{"children":"skill show"}],"."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Sessions"}],": owned headless Chromium by default,\n",["$","code",null,{"children":"--headed"}]," opt-in, ",["$","code",null,{"children":"--cdp"}]," borrows a foreign tab (it\ngets navigated — stated cost). ",["$","code",null,{"children":"close"}]," kills only\nowned browsers (TERM→wait→KILL, profile removed every\npath); foreign pids are never signaled."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Custom tools"}],": spec plus plain-JS body, compiled\ndebugger-side (CSP-exempt), fixture-proved before\npersisting (consequential tools hand-proved). Saved\nas ",["$","code",null,{"children":"<root>/<origin-slug>/<name>/{spec.json,body.js}"}],";\nevery ",["$","code",null,{"children":"open"}]," re-applies; rot surfaces as\n",["$","code",null,{"children":"staleSuspect"}],"; recovery is re-register."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Codemode"}],": ",["$","code",null,{"children":"search"}]," ranks across sessions with\ndeterministic field weights; ",["$","code",null,{"children":"execute"}]," runs one\nprogram over flat or namespaced (",["$","code",null,{"children":"sessions[]"}],") tools\nwith enforced budgets. Every envelope carries\n",["$","code",null,{"children":"untrusted: true"}],"."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Honesty rules"}],": piped output is JSON, writes need\n",["$","code",null,{"children":"--yes"}],", exits ",["$","code",null,{"children":"0"}]," ok / ",["$","code",null,{"children":"2"}]," usage / ",["$","code",null,{"children":"1"}]," failure with\nthe message on stderr."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Install"}],": Bun toolchain, Chromium 152+, source\nbuild (",["$","code",null,{"children":"bun run gate"}],", ",["$","code",null,{"children":"bun run compile"}],");\nper-OS release binaries attach from this version on."]}],"\n"]}]
