13:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Not a driver."}]," Snapshots, clicks, and fills are your\nharness's product, not this engine's."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Not a hosted service."}]," No accounts, no registry\nservice. Self-hostable, MIT."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Not an endorsement."}]," Authoring a tool for a site does\nnot bless the site. A site's reply is input, not\npermission."]}],"\n"]}]
