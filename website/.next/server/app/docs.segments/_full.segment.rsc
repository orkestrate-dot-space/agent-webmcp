a:["$","$1","c",{"children":[[["$","h1",null,{"id":"introduction","children":"Introduction"}],"\n",["$","p",null,{"children":"The web as your toolkit. agent-webmcp turns any live page\ninto callable tools: open a page, use the tools it exposes,\nauthor the ones it lacks, chain tools across sites in code,\nclose when done."}],"\n",["$","$L11",null,{"code":"agent-webmcp open https://example.com   # a session handle\nagent-webmcp list <handle>              # the page's tools\nagent-webmcp close <handle> --yes       # release it","lang":"bash"}],"\n",["$","h2",null,{"id":"how-it-works","children":"How it works"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Sessions hold pages."}]," ",["$","code",null,{"children":"open"}]," attaches a page and returns\na handle. Every later verb names that handle. See\n",["$","a",null,{"href":"/docs/quick-start","children":"Quick start"}],"."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Pages expose tools."}]," ",["$","code",null,{"children":"list"}]," shows what the page offers.\nNever call a tool you have not listed."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"You author what is missing."}]," ",["$","code",null,{"children":"register"}]," adds a custom\ntool to the page, proves it with a fixture, and saves it\nas files. See ",["$","a",null,{"href":"/docs/custom-tools","children":"Custom tools"}],"."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Code joins pages."}]," ",["$","code",null,{"children":"execute"}]," runs one program over\nsession tools, including cross-site joins. MCP only.\nSee ",["$","a",null,{"href":"/docs/codemode","children":"Codemode"}],"."]}],"\n"]}],"\n",["$","p",null,{"children":"The engine cannot inspect pages itself. Bring a discovery\nbundle from your browser driver (snapshot, eval, network,\npage source) and the agent carries that context across.\nRun engine plus driver side by side over MCP."}],"\n",["$","h2",null,{"id":"the-seven-verbs","children":"The seven verbs"}],"\n",["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Verb"}],["$","th",null,{"children":"Door"}],["$","th",null,{"children":"What it does"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"open"}]}],["$","td",null,{"children":"CLI+MCP"}],["$","td",null,{"children":"Attach a page, get a handle"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"list"}]}],["$","td",null,{"children":"CLI+MCP"}],["$","td",null,{"children":"Show a session's page tools"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"search"}]}],["$","td",null,{"children":"MCP"}],["$","td",null,{"children":"Rank tools across sessions"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"register"}]}],["$","td",null,{"children":"CLI+MCP"}],["$","td",null,{"children":"Author a custom tool onto the page"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"execute"}]}],["$","td",null,{"children":"MCP"}],["$","td",null,{"children":"Run code over session tools"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"close"}]}],["$","td",null,{"children":"CLI+MCP"}],["$","td",null,{"children":"Release sessions"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"unregister"}]}],["$","td",null,{"children":"CLI+MCP"}],["$","td",null,{"children":"Drop one authored tool, live only"}]]}]]}]]}],"\n",["$","p",null,{"children":["Composition (",["$","code",null,{"children":"search"}],", ",["$","code",null,{"children":"execute"}],") lives on MCP only. The\nCLI mirrors the lifecycle verbs. Piped output is JSON.\nWrites (",["$","code",null,{"children":"register"}],", ",["$","code",null,{"children":"unregister"}],", ",["$","code",null,{"children":"close"}],") need ",["$","code",null,{"children":"--yes"}],".\nExits: ",["$","code",null,{"children":"0"}]," ok, ",["$","code",null,{"children":"2"}]," usage (never retry as-is), ",["$","code",null,{"children":"1"}]," failure\nwith the message on stderr."]}],"\n",["$","h2",null,{"id":"works-with","children":"Works with"}],"\n",["$","p",null,{"children":"Any harness that can run a shell or speak MCP, plus a\nbrowser driver for discovery: agent-browser, chrome\ndevtools MCP setups, trace files, page source. The engine\nnever vendors a driver; servers never talk directly."}],"\n","$L12","\n","$L13"],null,"$L14"]}]
