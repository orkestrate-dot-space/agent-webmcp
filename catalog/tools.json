[
  {
    "id": "googlechromelabs.github.io/searchFlights",
    "site": "googlechromelabs.github.io",
    "url": "https://googlechromelabs.github.io/webmcp-tools/demos/react-flightsearch/",
    "name": "searchFlights",
    "description": "Search for flights between two airports on given dates, one way or round trip.",
    "kind": "read",
    "source": "native",
    "input_schema": {
      "type": "object",
      "properties": {
        "destination": {
          "type": "string",
          "description": "City or airport IATA code for the destination airport. Prefer city IATA codes when a specific airport is not provided. Example: 'RIO' for 'Rio de Janeiro'",
          "minLength": 3,
          "maxLength": 3,
          "pattern": "^[A-Z]{3}$"
        },
        "inboundDate": {
          "type": "string",
          "format": "date",
          "description": "The inbound date in YYYY-MM-DD format."
        },
        "origin": {
          "type": "string",
          "description": "City or airport IATA code for the origin. Prefer city IATA codes when a specific airport is not provided. Example: 'RIO' for 'Rio de Janeiro'",
          "minLength": 3,
          "maxLength": 3,
          "pattern": "^[A-Z]{3}$"
        },
        "outboundDate": {
          "type": "string",
          "format": "date",
          "description": "The outbound date in YYYY-MM-DD format."
        },
        "passengers": {
          "type": "number",
          "description": "The number of passengers."
        },
        "tripType": {
          "type": "string",
          "enum": [
            "one-way",
            "round-trip"
          ],
          "description": "The trip type. Can be \"one-way\" or \"round-trip\"."
        }
      },
      "required": [
        "origin",
        "destination",
        "tripType",
        "outboundDate",
        "inboundDate",
        "passengers"
      ]
    }
  },
  {
