{
  "name": "@agent-webmcp/usage",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create agent-webmcp-usage",
    "db:schema": "wrangler d1 execute agent-webmcp-usage --remote --file=./schema.sql",
    "db:schema:local": "wrangler d1 execute agent-webmcp-usage --local --file=./schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "^5.9.0",
    "wrangler": "^4.151.1"
  }
}
